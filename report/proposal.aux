\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Left: top-down body trajectories (five episodes per morphology) under an identical command sequence, aligned to a common start and heading and drawn at true aspect ratio. Right: per-episode path length and net displacement with mean $\pm $ standard deviation; the three morphologies do not overlap.}}{29}{figure.caption.18}\protected@file@percent }
\newlabel{fig:gap}{{3.4}{29}{Left: top-down body trajectories (five episodes per morphology) under an identical command sequence, aligned to a common start and heading and drawn at true aspect ratio. Right: per-episode path length and net displacement with mean $\pm $ standard deviation; the three morphologies do not overlap}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.7.2}The frozen encoder carries the required behaviour signal, entangled with body shape}{29}{subsection.3.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Morphology is strongly and ordinally encoded in the frozen embedding. (a) A supervised linear probe reaches ${\sim }100$ percent and holds under episode-grouped cross-validation. (b) Unsupervised PCA, given no labels, orders the three bodies by leg length along its leading component. (c) A UMAP projection, shown for illustration only. Leg length and recording session are confounded in this pilot.}}{30}{figure.caption.19}\protected@file@percent }
\newlabel{fig:morph-evidence}{{3.5}{30}{Morphology is strongly and ordinally encoded in the frozen embedding. (a) A supervised linear probe reaches ${\sim }100$ percent and holds under episode-grouped cross-validation. (b) Unsupervised PCA, given no labels, orders the three bodies by leg length along its leading component. (c) A UMAP projection, shown for illustration only. Leg length and recording session are confounded in this pilot}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Foot-contact behaviour is decodable within a body (mean macro-F1 0.84) but collapses across bodies (mean 0.16), and a shuffled-label control sits at the chance floor. The behaviour information is present but entangled with body shape, the signal the latent action must preserve while making it body-independent.}}{30}{figure.caption.20}\protected@file@percent }
\newlabel{fig:sanity}{{3.6}{30}{Foot-contact behaviour is decodable within a body (mean macro-F1 0.84) but collapses across bodies (mean 0.16), and a shuffled-label control sits at the chance floor. The behaviour information is present but entangled with body shape, the signal the latent action must preserve while making it body-independent}{figure.caption.20}{}}
