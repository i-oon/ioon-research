\@writefile{toc}{\contentsline {section}{\numberline {3.1}System Overview}{22}{section.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces System pipeline. A frozen V-JEPA2 encoder maps each RGB frame to an embedding $e_t$; the Inverse Transition Model infers the latent action $z_t$ from $(e_t, e_{t+1})$; the Forward Transition Model predicts $\hat  {e}_{t+1}$ from $(e_t, z_t)$ (loss $\mathcal  {L}_{\text  {recon}}$); and the Motion Decoder maps $z_t$ back to a body-specific joint command $\hat  {a}_t$ (loss $\mathcal  {L}_{\text  {motion}}$).}}{22}{figure.caption.13}\protected@file@percent }
\newlabel{fig:pipeline}{{3.1}{22}{System pipeline. A frozen V-JEPA2 encoder maps each RGB frame to an embedding $e_t$; the Inverse Transition Model infers the latent action $z_t$ from $(e_t, e_{t+1})$; the Forward Transition Model predicts $\hat {e}_{t+1}$ from $(e_t, z_t)$ (loss $\mathcal {L}_{\text {recon}}$); and the Motion Decoder maps $z_t$ back to a body-specific joint command $\hat {a}_t$ (loss $\mathcal {L}_{\text {motion}}$)}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.1}{\ignorespaces Input/output specification of each block in the pipeline.}}{22}{table.caption.14}\protected@file@percent }
\newlabel{tab:io}{{3.1}{22}{Input/output specification of each block in the pipeline}{table.caption.14}{}}
