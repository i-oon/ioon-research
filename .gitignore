# Python environment
.venv/
__pycache__/
*.py[cod]

# Scratch outputs
*.log

# Data: all datasets stay on disk, not in git (regenerable via scripts/dataset/ and scripts/run/)
data/

# Model checkpoints and caches (large, regenerable)
wm/runs/
wm/cache/
results/wm/cache*/
results/wm/cache_zeroshot/
results/dataset/**/emb.npz

# Reference repos / tools checked out locally
doc/ref/Demo-JEPA/
doc/ref/Egocentric_VSM/
doc/ref/Slalom-structure/
latex-document-skill/

# Compiled report artifacts (regenerable via report/build_preview.sh or xelatex) — not the source
report/thai_abstract_standalone.pdf
report/*.aux
report/*.toc
report/*.out

# Archived / invalidated results (moved, not deleted; see MANIFEST.txt inside each)
*_archive*/
_invalid_*/
